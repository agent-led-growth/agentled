# Copy to .env.local and fill in. Never commit .env.local.
#
# Minimal set to boot a self-hosted instance: Supabase + OpenAI.
# Everything under "Optional" degrades gracefully when unset (the related
# feature is disabled rather than crashing). See src/lib/env.ts.

# =============================================================================
# Required
# =============================================================================

# --- Supabase (Postgres + Auth) ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---
# Powers the AI Search scan engine. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# =============================================================================
# Optional
# =============================================================================

# --- Internal secret ---
# Shared secret guarding the internal scan-execute/-fail routes that the
# scan-consumer worker calls server-to-server. Required only if you run the
# background scan workers; generate any random string (e.g. `openssl rand -hex 32`).
INTERNAL_SECRET=

# --- Resend (transactional email / onboarding) ---
# Full-access key (contacts + events + send). Unset = onboarding email disabled.
RESEND_API_KEY=

# --- Stripe (billing) ---
# Only needed to run the paid plans. Self-hosters can leave these blank and set
# SELF_HOSTED=true (below) to skip billing entirely.
STRIPE_SECRET_KEY=
# Webhook signing secret for /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# Optional: a Customer Portal configuration scoped to your plans. When absent,
# the portal falls back to the Stripe account default.
STRIPE_PORTAL_CONFIGURATION_ID=
# The six price ids (starter/pro/business × monthly/yearly), read via
# src/lib/stripe/prices.ts. Env-driven so swapping test<->live prices is config.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# --- Jina Reader (page enrichment) ---
# Keyless works from residential IPs (local dev) but is refused from Cloudflare's
# egress; set it if you deploy scans to Workers. Unset = enrichment best-effort.
JINA_API_KEY=

# --- PostHog (product analytics) ---
# Project Settings -> Project API Key (starts with phc_). Public by design.
# Host: https://eu.i.posthog.com (EU cloud) or https://us.i.posthog.com (US).
# Unset = analytics disabled (no tracking, no bundle impact).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Self-hosting ---
# Set to true to run without billing: skips Stripe and removes plan-based gating
# on scan cadence. Leave unset/false for the hosted commercial configuration.
SELF_HOSTED=
