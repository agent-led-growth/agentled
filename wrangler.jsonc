{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentled",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },

  // Stripe live price ids (Epic 6). Not secret — public identifiers read at
  // runtime by src/lib/stripe/prices.ts. Local dev/test uses its own test-mode
  // ids in .env.local; production uses these live ones. Swapping a price is a
  // change here, not a code change.
  "vars": {
    "STRIPE_PRICE_STARTER_MONTHLY": "price_1U4iAiLrSZ1ZGVqmWH5OYRJj",
    "STRIPE_PRICE_STARTER_YEARLY": "price_1U4iCDLrSZ1ZGVqmK9PTJ4ae",
    "STRIPE_PRICE_PRO_MONTHLY": "price_1U4iFdLrSZ1ZGVqm93L3KZkZ",
    "STRIPE_PRICE_PRO_YEARLY": "price_1U4iFdLrSZ1ZGVqmeaTjjQJw",
    "STRIPE_PRICE_BUSINESS_MONTHLY": "price_1U4iH7LrSZ1ZGVqmG5Somx9q",
    "STRIPE_PRICE_BUSINESS_YEARLY": "price_1U4iHuLrSZ1ZGVqm5zx7iASg"
  },

  // Producer only: the app enqueues one-time scan jobs. The consumer is a
  // separate worker (workers/scan-consumer) so we don't touch the generated
  // OpenNext entry.
  "queues": {
    "producers": [{ "queue": "agentled-scan", "binding": "SCAN_QUEUE" }]
  },

  // Custom domain. Cloudflare manages the DNS record and certificate for this
  // hostname automatically; the zone must already exist on the account.
  "routes": [{ "pattern": "agentled.co", "custom_domain": true }]

  // Secrets (NEXT_PUBLIC_* live in .env / CI and are inlined at build time;
  // server-only values are set with `wrangler secret put <NAME>`):
  //   NEXT_PUBLIC_POSTHOG_KEY   (build-time, public)
  //   SUPABASE_SERVICE_ROLE_KEY
  //   RESEND_API_KEY
  //   INTERNAL_SECRET           (shared with the scan-consumer worker)
  //   STRIPE_SECRET_KEY         (live sk_live_… — Epic 6)
  //   STRIPE_WEBHOOK_SECRET     (live endpoint signing secret — Epic 6)
}
