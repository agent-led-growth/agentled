{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentled",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },

  // Producer only: the app enqueues one-time scan jobs. The consumer is a
  // separate worker (workers/scan-consumer) so we don't touch the generated
  // OpenNext entry.
  "queues": {
    "producers": [{ "queue": "agentled-scan", "binding": "SCAN_QUEUE" }]
  },

  // Custom domain. Cloudflare manages the DNS record and certificate for this
  // hostname automatically; the zone must already exist on the account.
  "routes": [{ "pattern": "agentled.co", "custom_domain": true }]

  // Secrets (NEXT_PUBLIC_* live in .env / CI and are inlined at build time;
  // server-only values are set with `wrangler secret put <NAME>`):
  //   NEXT_PUBLIC_POSTHOG_KEY   (build-time, public)
  //   SUPABASE_SERVICE_ROLE_KEY
  //   RESEND_API_KEY
  //   INTERNAL_SECRET           (shared with the scan-consumer worker)
}
